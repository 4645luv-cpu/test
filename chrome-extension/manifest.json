{
  "manifest_version": 3,
  "name": "Drive「のコピー」削除ツール",
  "version": "1.0",
  "description": "Google Driveのファイル名から「のコピー」を一括削除します",
  "permissions": [
    "identity"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "YOUR_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Drive「のコピー」削除"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
